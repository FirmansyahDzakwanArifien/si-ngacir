; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Si Ngacir"
config/version="0.7.0"
config/description="Trobos Ajalah! Game kurir capybara."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Screen="*res://scripts/autoload/screen.gd"
GameState="*res://scripts/autoload/game_state.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
Transition="*res://scripts/autoload/transition.gd"
Accessibility="*res://scripts/autoload/accessibility.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=672
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[internationalization]

locale/translations=PackedStringArray("res://translations/strings.en.translation")
locale/fallback="id"

[rendering]

renderer/rendering_method="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.105, 0.11, 0.165, 1)
