script = ExtResource("1_story")
pages = PackedStringArray("Hari keempat. Badai turun tepat di jam sibuk, genangan di mana-mana.", "Gak ada waktu buat neduh! Laptop VIP punya Nana harus sampai kering. Pakai jas hujanmu, ngacir sekarang!", "Hujan, ya... padahal enak banget berendam air hangat sekarang.", "Laptop saya harus sampai sebelum rapat! Telat satu detik, bintang satu!", "Jarak pandang pendek dan aspal licin. Jangan sampai laptopnya tercebur!")
