[gd_resource type="Resource" script_class="StoryData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/story_data.gd" id="1_story"]

[resource]
script = ExtResource("1_story")
pages = PackedStringArray("Kota Ngacir, suatu pagi. Masbro, capybara paling santai sekampung, tinggal berdua dengan adiknya, Nana.", "Bang, sore nanti kita main ke taman, ya? Janji!", "Santai. Abang pulang cepat hari ini.", "Tapi sore itu, Nana demam tinggi dan tidak bisa bangun dari kasur.", "Nana harus dirawat. Biayanya {target}, paling lambat lima hari lagi.", "Lima hari...?", "Abang jangan sedih. Nana kuat, kok.", "Keesokan paginya, Masbro melihat lowongan di Ngacir Express: kurir masa percobaan, dibayar harian.", "Lima hari masa percobaan. Telat atau paket rusak, upahmu dipotong. Lolos, kamu jadi kurir tetap.", "Heh, kurir baru? Di sini yang cepat yang dapat. Jangan nangis kalau kesalip, ya!", "Cepat boleh, asal paketnya selamat.", "Kejar Timer ETA. Jaga paket dari benturan. Jangan sampai upah terpotong denda ganti rugi.\n\nTrobos Ajalah!")
images = PackedStringArray("home", "home", "home", "sick", "hospital", "hospital", "hospital", "office", "office", "depot", "depot", "road")
speakers = PackedStringArray("", "nana:senang", "masbro:senang", "", "dokter:normal", "masbro:kaget", "nana:sakit", "", "direktur:normal", "kilat:sombong", "masbro:mantap", "")
