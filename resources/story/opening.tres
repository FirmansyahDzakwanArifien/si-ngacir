[ext_resource type="Script" path="res://scripts/data/story_data.gd" id="1_story"]

[resource]
script = ExtResource("1_story")
pages = PackedStringArray("Kota Ngacir, kota yang tidak pernah berhenti ngebut. Di tengahnya ada Kedai Chill: kedai minum dan kolam air hangat milik Masbro, tempat warga kota melepas penat.", "Air hangat, jeruk dingin, hidup tenang.", "Sore itu pintu kedai digedor. Pemilik Lahan datang membawa Surat Peringatan Ketiga.", "Sewa kedai ini nunggak tiga bulan. Totalnya {target}. Lima hari lagi belum lunas, tempat ini saya kosongkan.", "Lima hari...? Boleh dicicil, Pak?", "Boleh. Asal lunas dalam lima hari.", "Kerja yang dibayar harian cuma satu: kurir masa percobaan Ngacir Express. Masbro memasang jeruk di kepala, lalu mendaftar.", "Saya Bos Koko, kepala kurir. Moto kita: Kalo gak kilat, gak selamat!", "Kurir kita jalan kaki. Kota semacet ini, yang berani nyeberang yang sampai duluan. Telat, upah dipotong. Paket rusak, ganti rugi!", "Kurir baru? Kapibara? Jalanan kota cuma muat buat yang gesit. Mending balik berendam sana.", "Santai. Cepat boleh, asal paketnya selamat.", "Kejar Timer ETA. Jaga paket dari benturan. Kumpulkan upah untuk melunasi sewa Kedai Chill.\n\nTrobos Ajalah!")
images = PackedStringArray("kedai", "kedai", "sp3", "sp3", "sp3", "sp3", "office", "office", "office", "depot", "depot", "road")
speakers = PackedStringArray("", "masbro:senang", "", "pemilik:marah", "masbro:kaget", "pemilik:normal", "", "koko:normal", "koko:marah", "kuro:sombong", "masbro:mantap", "")
