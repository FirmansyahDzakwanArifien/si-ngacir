[gd_resource type="Resource" script_class="StoryData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/story_data.gd" id="1_story"]

[resource]
script = ExtResource("1_story")
pages = PackedStringArray("Hari kedua! Kue ulang tahun tiga tingkat plus akuarium cupang untuk cucu Bu Sri. Dua-duanya rapuh, akuariumnya berat.", "Yo, kapibara! Bawa akuarium jalan kaki? Hari ini aku lewat rute yang sama. Jangan nangis kalau kesalip!", "Bawa kue itu mirip bawa ketenangan jiwa, Kuro. Pelan tapi pasti.", "Gak ada pelan-pelan! Cepat tapi utuh! Awas kulit pisang, Kuro suka buang sampah dari motornya.", "Akuariumnya berat, langkah Masbro jadi lebih lambat. Rute hari ini juga melewati sungai. Atur waktu menyeberang!")
images = PackedStringArray("depot", "depot", "depot", "depot", "kue")
speakers = PackedStringArray("koko:normal", "kuro:sombong", "masbro:normal", "koko:marah", "")
