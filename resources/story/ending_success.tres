script = ExtResource("1_story")
pages = PackedStringArray("Patung kristal saya sampai dengan selamat! Terima kasih, Kurir Kapibara.", "SQUAWK! Selamat, Masbro. Mulai besok kamu kurir tetap Ngacir Express!", "Hmph. Kali ini kamu menang. ...Kedai Chill-mu masih buka, kan? Aku boleh mampir?", "Tabungan {saved} cukup untuk melunasi sewa {target}.", "Lunas. Kedai Chill boleh tetap buka.", "Kedai aman. Saatnya balik berendam.", "Kedai Chill selamat, dan kini jadi tempat istirahat para kurir kota. Trobos Ajalah, Masbro!")
images = PackedStringArray("kristal", "office", "depot", "kedai", "kedai", "celebrate", "celebrate")
